# ==============================================================================
# TrackIT Environment Configuration (.env.example)
# Copy this file to .env and adjust variables for your local/production environment
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment: 'development', 'testing', 'production'
ENVIRONMENT=development
APP_NAME="TrackIT — Smart IT Service & Issue Management Platform"
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration
# For PostgreSQL (Docker or Local):
# DATABASE_URL=postgresql://trackit_user:trackit_password@localhost:5432/trackit_db
# For zero-config local development without PostgreSQL daemon running:
DATABASE_URL=sqlite:///./trackit.db

# Security & JWT Authentication
# Run `openssl rand -hex 32` to generate a secure secret key in production
JWT_SECRET_KEY=trackit_super_secret_development_key_change_in_production_9876543210
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SLA Configuration (in Hours)
SLA_LOW_HOURS=72
SLA_MEDIUM_HOURS=24
SLA_HIGH_HOURS=8
SLA_CRITICAL_HOURS=4

# Server Configuration
HOST=0.0.0.0
PORT=8000
